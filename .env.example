# ============================================================
# Backend (src/Server/.env) — never expose these to the browser
# ============================================================

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Young Giza <onboarding@resend.dev>
OWNER_EMAIL=you@example.com

# Frontend origin for CORS + Stripe success/cancel URLs
# Comma-separate additional origins if needed
CLIENT_URL=http://localhost:5173

PORT=3000

# Supabase — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Optional alias used by some docs; the server also accepts this
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ============================================================
# Frontend (project-root .env) — VITE_ values are public
# ============================================================

# Leave empty in local Vite dev if you use the /api proxy in vite.config.ts
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
